PROJECT_NAME="Falcon API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG_MODE=True
TIME_ZONE="UTC"

# Supabase Postgres connection URI (Project Settings -> Database -> Connection string).
# Leave empty to fall back to in-memory mission storage.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=10
