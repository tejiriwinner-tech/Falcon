# Falcon Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=10

# API Keys
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
FMP_API_KEY=your_fmp_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Provider URLs
TWELVEDATA_BASE_URL=https://api.twelvedata.com
FMP_BASE_URL=https://financialmodelingprep.com/stable
ALPHA_BASE_URL=https://www.alphavantage.co/query

# Security Configuration (Phase 3)
FALCON_API_KEY=your_secure_api_key_here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=False
RATE_LIMIT_PER_MINUTE=100

# Calendar Configuration
CALENDAR_LOOKAHEAD_DAYS=7
CALENDAR_CACHE_SECONDS=900

# Historical Data Configuration
HISTORY_BAR_LIMIT=500
HISTORY_TIMEFRAME=1h
HISTORY_REFRESH_SECONDS=900

# Mock Provider (Development Only)
ENABLE_MOCK_PROVIDER=False

# Starting Equity for Trade Journal
STARTING_EQUITY=10000

# Signal Pipeline Configuration
USE_PRICE_HISTORY_FOR_SIGNALS=true

# Market Data Scheduler Configuration
MARKET_DATA_WATCHLIST=XAUUSD,GBPUSD,EURUSD
MARKET_DATA_INGESTION_INTERVAL_SECONDS=300
INITIAL_BACKFILL_DELAY_SECONDS=30