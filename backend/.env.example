PROJECT_NAME="Falcon API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG_MODE=True
TIME_ZONE="UTC"

# Supabase Postgres connection URI (Project Settings -> Database -> Connection string).
# Leave empty to fall back to in-memory mission storage.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=10

# Account equity the trade journal analytics are measured against.
STARTING_EQUITY=10000

# Market data providers. A missing key disables that provider; it never crashes
# the pipeline, and no fabricated data is substituted.
TWELVEDATA_BASE_URL="https://api.twelvedata.com"
TWELVEDATA_API_KEY=

# Economic calendar
FMP_BASE_URL="https://financialmodelingprep.com/api"
FMP_API_KEY=

# Quotes and FX history fallback
ALPHA_BASE_URL="https://www.alphavantage.co/query"
ALPHA_VANTAGE_API_KEY=

# Calendar window and cache
CALENDAR_LOOKAHEAD_DAYS=7
CALENDAR_CACHE_SECONDS=900

# Price history backfill
HISTORY_BAR_LIMIT=500
HISTORY_TIMEFRAME=1h
HISTORY_REFRESH_SECONDS=900

# Development only: serve synthetic quotes when no provider is configured.
ENABLE_MOCK_PROVIDER=False
